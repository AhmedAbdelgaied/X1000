# =============================================================================
# Linksys X1000 — UCI QoS Config: SQM with CAKE
# =============================================================================
# SQM (Smart Queue Management) eliminates bufferbloat on the PPPoE WAN link.
# Uses the CAKE queue discipline — best overall algorithm for home routers.
#
# IMPORTANT before enabling:
#   1. Disable hardware flow offloading:
#      Network → Firewall → uncheck "Software flow offloading"
#      Network → Firewall → uncheck "Hardware flow offloading"
#   2. Set speeds to ~90% of your actual ISP line speed (not theoretical max)
#
# Apply:
#   scp config/sqm.uci root@192.168.1.1:/etc/config/sqm
#   ssh root@192.168.1.1 "uci commit sqm && /etc/init.d/sqm enable && /etc/init.d/sqm start"
#
# Or via LuCI: Network → SQM QoS → Add instance
# =============================================================================

# SQM instance on the PPPoE WAN interface
config queue 'eth0'
	option enabled '1'
	option interface 'pppoe-wan'    # PPPoE interface name (confirm with: ip link)
	                                # Could also be 'eth0.30' if PPPoE not used

	# ── Speed settings ──────────────────────────────────────────────────────
	# Set to ~90% of your actual measured ISP speed (run a speed test first)
	# Example: if ISP gives 10 Mbps down / 1 Mbps up:
	option download '9000'          # kbps download limit (← adjust)
	option upload   '900'           # kbps upload limit   (← adjust)

	# ── Queue discipline: CAKE (best for single-user home link) ─────────────
	option qdisc 'cake'
	option script 'cake.qos'

	# ── CAKE options ─────────────────────────────────────────────────────────
	# diffserv3: classifies traffic into 3 tiers (bulk/normal/priority)
	# triple-isolate: per-host fairness (LAN hosts share fairly)
	# nat: CAKE performs NAT-aware flow classification
	# memlimit 32mb: cap memory use on this low-RAM device
	option qdisc_advanced '1'
	option ingress_ecn 'ECN'
	option egress_ecn 'NOECN'
	option qdisc_options 'diffserv3 triple-isolate nat memlimit 32mb'

	# ── Overhead compensation (PPPoE + VLAN) ────────────────────────────────
	# PPPoE adds 8 bytes overhead per packet; VLAN 802.1Q adds 4 bytes
	# CAKE can compensate automatically:
	option overhead_type 'PPPOEOA'  # or set manually:
	# option overhead '40'          # PPPoE(8) + Ethernet(14) + VLAN(4) + IP overhead
