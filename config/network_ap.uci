# =============================================================================
# Linksys X1000 — UCI Network Config: ACCESS POINT mode
# =============================================================================
# The device bridges all LAN+WAN ports and Wi-Fi under br-lan.
# DHCP server DISABLED — upstream router handles DHCP.
# Device gets a static IP on the upstream network.
#
# Apply:
#   scp config/network_ap.uci root@192.168.1.1:/etc/config/network
#   ssh root@192.168.1.1 "uci commit network && /etc/init.d/network restart"
# =============================================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00::/48'

# Bridge all physical ports (WAN port eth0 + LAN switch eth1) + Wi-Fi
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	list ports 'eth1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.2'     # free IP on upstream subnet — change if needed
	option netmask '255.255.255.0'
	option gateway '192.168.1.1'    # upstream router IP
	option dns '8.8.8.8 1.1.1.1'
	option ipv6 'auto'
