# =============================================================================
# Linksys X1000 — UCI Wireless Config
# Wi-Fi chip: BCM43217KMLG (PCIe, 2.4 GHz, 802.11n)
# Driver:     brcmsmac
# SSID:       Abdelgaied
# Password:   ++010000948555
# =============================================================================
#
# IMPORTANT — BCM43217 + brcmsmac driver notes:
#   • 802.11n 2.4 GHz — 2×2 MIMO, up to 300 Mbps PHY rate
#   • AP mode: supported (verify with `iw list` after boot)
#   • Concurrent STA+AP (repeater): brcmsmac may NOT support both interfaces
#     simultaneously. If repeater mode fails, see config/wifi_scan.md for
#     the wired-WAN + Wi-Fi-AP fallback.
#   • Scan: `iwinfo wlan0 scan` or LuCI → Network → Wireless → Scan button
#
# Apply:
#   scp config/wireless.uci root@192.168.1.1:/etc/config/wireless
#   ssh root@192.168.1.1 "uci commit wireless && wifi reload"
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# SHARED radio device — used by all three modes
# ─────────────────────────────────────────────────────────────────────────────

config wifi-device 'radio0'
	option type 'mac80211'
	# PCIe path for BCM43217 — confirm with: find /sys/bus/pci -name "wireless" 2>/dev/null
	option path 'pci0000:00/0000:00:00.0'
	option band '2g'
	option channel '6'              # 1, 6, or 11 for non-overlapping channels
	option htmode 'HT20'            # HT20=20 MHz, HT40+=40 MHz (try HT20 first)
	option hwmode '11n'             # 802.11n — BCM43217 supports n-mode
	option txpower '20'             # dBm — check local regulations
	option country 'EG'             # Egypt country code
	option disabled '0'


# =============================================================================
# SECTION A: ACCESS POINT mode
# (Use with network_ap.uci)
# =============================================================================

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Abdelgaied'
	option encryption 'psk2+ccmp'  # WPA2-AES
	option key '++010000948555'
	option isolate '0'
	option disassoc_low_ack '1'
	option wps_pushbutton '0'


# =============================================================================
# SECTION B: PPPoE + VLAN mode — Wi-Fi config is identical to Section A
# (Use with network_pppoe_vlan.uci)
# Just change option network 'lan' — same SSID/password as AP mode
# =============================================================================

# config wifi-iface 'default_radio0'
# 	option device 'radio0'
# 	option network 'lan'
# 	option mode 'ap'
# 	option ssid 'Abdelgaied'
# 	option encryption 'psk2+ccmp'
# 	option key '++010000948555'


# =============================================================================
# SECTION C: REPEATER mode (STA + AP on single radio)
# (Use with network_repeater.uci)
#
# NOTE: brcmsmac concurrent STA+AP support is uncertain on BCM43217.
# After flashing, run `iw list` and check "valid interface combinations".
# If "AP + managed" combo is listed → repeater works natively.
# If not listed → use the wired WAN fallback in config/wifi_scan.md
# =============================================================================

# # STA: connects to upstream router as client
# config wifi-iface 'wwan'
# 	option device 'radio0'
# 	option network 'wwan'
# 	option mode 'sta'
# 	option ssid 'UpstreamRouterSSID'    # upstream SSID
# 	option encryption 'psk2'
# 	option key 'UpstreamPassword'
# 	# option bssid 'AA:BB:CC:DD:EE:FF' # optional: lock to specific AP
#
# # AP: local access point for clients
# config wifi-iface 'ap'
# 	option device 'radio0'
# 	option network 'lan'
# 	option mode 'ap'
# 	option ssid 'Abdelgaied'
# 	option encryption 'psk2+ccmp'
# 	option key '++010000948555'
