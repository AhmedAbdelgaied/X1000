# =============================================================================
# Linksys X1000 — UCI Repeater Daemon Config: relayd
# =============================================================================
# relayd bridges two network interfaces at L3 for repeater mode.
# It relays DHCP, broadcasts, and ARP between wwan (upstream STA) and lan (local AP).
#
# Apply:
#   scp config/relayd.uci root@192.168.1.1:/etc/config/relayd
#   ssh root@192.168.1.1 "uci commit relayd && /etc/init.d/relayd enable && /etc/init.d/relayd start"
# =============================================================================

config relay
	option network1 'lan'           # local AP + wired ports
	option network2 'wwan'          # upstream STA wireless connection
	option forward_bcast '1'        # relay broadcast (needed for DHCP)
	option forward_dhcp '1'         # relay DHCP discover/offer
	option gateway '192.168.1.1'    # upstream router IP (← adjust to match upstream)
	option expiry '3600'            # ARP/neighbour entry timeout (seconds)
