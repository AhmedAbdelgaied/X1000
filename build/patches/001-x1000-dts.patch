--- a/target/linux/bcm63xx/dts/BCM63281_DSL2750B_B1.dts
+++ b/target/linux/bcm63xx/dts/BCM63281_LINKSYS_X1000.dts
@@ -1,8 +1,12 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
+// Linksys X1000 — Annex A variant
+// Board: BCM63281TKFBG + BCM43217KMLG (PCIe Wi-Fi)
+// RAM:   Winbond W9751G6KB-25 (64 MB DDR2)
+// Flash: MXIC MX25L6406E (8 MB SPI NOR)
+// Wi-Fi: BCM43217KMLG on PCIe bus → brcmsmac driver
+// DSL:   Annex A (POTS) — disabled, no open-source driver
 
 /dts-v1/;
 
-/* D-Link DSL-2750B rev B1 */
+/* Linksys X1000 (Annex A) */
 
 #include "bcm63281.dtsi"
 
@@ -10,14 +14,14 @@
 / {
-	model = "D-Link DSL-2750B rev B1";
-	compatible = "dlink,dsl-2750b-b1", "brcm,bcm63281";
+	model = "Linksys X1000";
+	compatible = "linksys,x1000", "brcm,bcm63281";
 
 	aliases {
 		serial0 = &uart0;
 	};
 
 	chosen {
 		bootargs = "console=ttyS0,115200n8";
 		stdout-path = "serial0:115200n8";
 	};
 };
 
 &pflash {
-	/* 8 MB SPI NOR */
+	/* 8 MB MXIC MX25L6406E SPI NOR */
 	status = "okay";
 
 	partitions {
 		compatible = "fixed-partitions";
 		#address-cells = <1>;
 		#size-cells = <1>;
 
+		/* CFE bootloader — NEVER overwrite */
 		partition@0 {
-			label = "cfe";
+			label = "bootloader";
 			reg = <0x000000 0x010000>;  /* 64 KB */
 			read-only;
 		};
 
+		/* Firmware: kernel + squashfs rootfs (~7.875 MB usable) */
 		partition@10000 {
 			label = "firmware";
 			reg = <0x010000 0x7e0000>;
 		};
 
+		/* CFE NVRAM — board ID, MAC addresses — preserve on upgrade */
 		partition@7f0000 {
 			label = "nvram";
 			reg = <0x7f0000 0x010000>;  /* 64 KB */
 		};
 	};
 };
 
-/* DSL modem node — Broadcom closed-source only, removed */
-&dsl {
-	status = "disabled";
-};
+/*
+ * DSL/ADSL node intentionally omitted.
+ * X1000 repurposed as AP / PPPoE-router / Repeater.
+ * No Broadcom open-source ADSL driver exists.
+ */
 
 &ethernet {
 	status = "okay";
+	/* MAC base address read from CFE NVRAM at boot */
 	nvmem-cells = <&macaddr_nvram>;
 	nvmem-cell-names = "mac-address";
 };
 
+/*
+ * PCIe bus — hosts BCM43217KMLG Wi-Fi chip
+ * Driver: brcmsmac (mac80211 SoftMAC)
+ */
