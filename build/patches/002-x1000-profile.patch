--- a/target/linux/bcm63xx/image/bcm63xx.mk
+++ b/target/linux/bcm63xx/image/bcm63xx.mk
@@ -1,6 +1,78 @@
 # SPDX-License-Identifier: GPL-2.0-only
 #
+# ===========================================================================
+# Linksys X1000 — BCM63281 + BCM43217 board profile
+# Hardware confirmed:
+#   CPU:   BCM63281TKFBG @ 320 MHz (MIPS32)
+#   RAM:   Winbond W9751G6KB-25 (64 MB DDR2)
+#   Flash: MXIC MX25L6406E (8 MB SPI NOR)
+#   Wi-Fi: BCM43217KMLG (PCIe, 2.4 GHz 802.11n, brcmsmac driver)
+#   ETH:   3×LAN + 1×WAN (10/100 Mbps)
+#   DSL:   Annex A — DISABLED (repurposed as AP/Repeater/PPPoE router)
+# ===========================================================================

+define Device/linksys_x1000
+  DEVICE_VENDOR   := Linksys
+  DEVICE_MODEL    := X1000
+  DEVICE_VARIANT  := Annex-A
+  DEVICE_DTS      := BCM63281_LINKSYS_X1000
+  DEVICE_DTS_DIR  := ../dts

+  # Flash: 8 MB total
+  #   0x000000 - 0x010000 : CFE bootloader (64 KB, read-only)
+  #   0x010000 - 0x7F0000 : firmware      (~7.875 MB usable)
+  #   0x7F0000 - 0x800000 : NVRAM         (64 KB, preserved)
+  IMAGE_SIZE      := 7872k
+  BLOCKSIZE       := 128k
+  FILESYSTEMS     := squashfs
+  CFE_BOARD_ID    := "X1000"
+  CFE_CHIP_ID     := 63281

+  # -------------------------------------------------------------------------
+  # Package set — carefully balanced for 8 MB flash
+  # -------------------------------------------------------------------------
+  DEVICE_PACKAGES := \
+    \
+    kmod-brcmsmac \
+    brcmsmac-firmware \
+    \
+    wpad \
+    iwinfo \
+    iw \
+    \
+    kmod-pppoe \
+    ppp \
+    ppp-mod-pppoe \
+    \
+    kmod-8021q \
+    kmod-swconfig \
+    swconfig \
+    \
+    relayd \
+    \
+    luci-base \
+    luci-mod-admin-full \
+    luci-theme-bootstrap \
+    luci-proto-ppp \
+    luci-app-firewall \
+    uhttpd \
+    uhttpd-mod-ubus \
+    \
+    luci-app-sqm \
+    kmod-sched-core \
+    kmod-sched-cake \
+    sqm-scripts \
+    \
+    luci-app-nlbwmon \
+    nlbwmon \
+    \
+    ip-full \
+    ethtool \
+    tc-full \
+    kmod-ifb

+  # Image: wrap kernel+rootfs into CFE-flashable binary
+  IMAGES += squashfs-cfe.bin
+  IMAGE/squashfs-cfe.bin := append-rootfs | pad-rootfs | \
+                             append-kernel | pad-to $$(IMAGE_SIZE) | \
+                             bcm63xx-cfe-image
+endef

+TARGET_DEVICES += linksys_x1000

 # existing devices follow...
